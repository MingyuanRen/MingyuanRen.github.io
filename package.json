{
  "name": "playful-personal-site-template",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build:pages": "GITHUB_PAGES=true vinext build && node build/prepare-pages.mjs",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "cms": "node --env-file-if-exists=.env.translation --env-file-if-exists=.env.images build/writing-server.mjs",
    "auth:check": "WRANGLER_LOG_PATH=.wrangler/auth.log wrangler deploy --config auth/wrangler.jsonc --dry-run --outdir ../dist/auth",
    "auth:deploy": "WRANGLER_LOG_PATH=.wrangler/auth.log wrangler deploy --config auth/wrangler.jsonc",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "markdown-it": "15.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.11",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.10",
    "vite": "8.0.16",
    "wrangler": "4.133.0"
  },
  "type": "module"
}
